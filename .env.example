# Default local behavior
TASK_EXTRACTION_PROVIDER=auto
CALENDAR_PROVIDER=mock

# OpenAI (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Gemini (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider token encryption (server only; at least 32 random characters)
PROVIDER_TOKEN_ENCRYPTION_SECRET=

# Google OAuth (server only except public callback origin)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Optional demo seed override
DEMO_USER_EMAIL=demo@planpilot.local
DEMO_USER_PASSWORD=
