# AI extraction provider selection
TASK_EXTRACTION_PROVIDER=auto
CALENDAR_PROVIDER=mock

# OpenAI (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Multimodal model for screenshot/PDF transcription.
OPENAI_DOCUMENT_MODEL=gpt-6-astra
TASK_EXTRACTION_ARCHITECTURE=direct
# Optional second request for malformed provider output; leave off to save calls.
OPENAI_EXTRACTION_REPAIR=1
# Source-verification pass after a valid Luna draft. Use `auto` to verify only
# ambiguous, corrected, relational, recurrent, tabular, or otherwise high-risk
# imports; use `1` to verify every draft or `0` to disable the second request.
OPENAI_EXTRACTION_VERIFY=auto

# Gemini (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Leave temperature blank to use Gemini 3's recommended default of 1.0.
GEMINI_TEMPERATURE=
# Optional: minimal, low, medium, or high. Blank uses the model default.
GEMINI_THINKING_LEVEL=
# Optional token/latency diagnostics; logs no source content or credentials.
GEMINI_LOG_USAGE=0

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider token encryption (server only; at least 32 random characters)
PROVIDER_TOKEN_ENCRYPTION_SECRET=

# Google OAuth (server only except public callback origin)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Optional demo seed override
DEMO_USER_EMAIL=demo@planpilot.local
DEMO_USER_PASSWORD=
